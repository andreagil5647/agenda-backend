{
  "openapi": "3.1.0",
  "info": {
    "title": "Agenda API",
    "version": "0.1.0",
    "description": "REST API for Agenda: calendars, events, tasks and reminders.\n\nErrors always use the `ErrorResponse` shape. Clients should branch on `code`, not on `message`.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the web app"
    }
  ],
  "components": {
    "schemas": {
      "Liveness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "description": "Short commit hash of the deployed build, or \"dev\""
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "VALIDATION_ERROR",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ],
            "description": "Stable machine-readable code, used by clients for i18n"
          },
          "message": {
            "type": "string",
            "description": "Human-readable English description, for logs and debugging"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string",
            "description": "Also returned in the X-Request-Id header"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "AuthenticatedSession": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "expiresAt",
          "csrfToken"
        ]
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/UserSettings"
          },
          "isDemo": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "settings",
          "isDemo"
        ]
      },
      "UserSettings": {
        "type": "object",
        "properties": {
          "timeZone": {
            "type": "string"
          },
          "weekStartsOn": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  6
                ]
              }
            ]
          },
          "hourCycle": {
            "type": "string",
            "enum": [
              "h12",
              "h23"
            ]
          },
          "locale": {
            "type": "string"
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "accentColor": {
            "type": "string"
          }
        },
        "required": [
          "timeZone",
          "weekStartsOn",
          "hourCycle",
          "locale",
          "theme",
          "accentColor"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Plain-text password, accepted only in register/login requests"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Plain-text password, accepted only in register/login requests"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionResponse": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/AuthenticatedSession"
          },
          {
            "$ref": "#/components/schemas/AnonymousSession"
          }
        ]
      },
      "AnonymousSession": {
        "type": "object",
        "properties": {
          "user": {
            "type": "null"
          }
        },
        "required": [
          "user"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/UserSettings"
          },
          "isDemo": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "settings",
          "isDemo"
        ]
      },
      "PatchSettingsRequest": {
        "type": "object",
        "properties": {
          "timeZone": {
            "type": "string"
          },
          "weekStartsOn": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  0
                ]
              },
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  6
                ]
              }
            ]
          },
          "hourCycle": {
            "type": "string",
            "enum": [
              "h12",
              "h23"
            ]
          },
          "locale": {
            "type": "string"
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "accentColor": {
            "type": "string"
          }
        }
      },
      "Calendar": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "colorKey": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "defaultReminderMinutes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "order": {
            "type": "number"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "colorKey",
          "visible",
          "defaultReminderMinutes",
          "order",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateCalendarRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "colorKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "default": "blue"
          },
          "visible": {
            "type": "boolean",
            "default": true
          },
          "defaultReminderMinutes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10080
            },
            "default": []
          }
        },
        "required": [
          "name"
        ]
      },
      "PatchCalendarRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "colorKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "default": "blue"
          },
          "visible": {
            "type": "boolean",
            "default": true
          },
          "defaultReminderMinutes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10080
            },
            "default": []
          }
        }
      },
      "CalendarOrderRequest": {
        "type": "object",
        "properties": {
          "calendarIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$/i"
            },
            "minItems": 1
          }
        },
        "required": [
          "calendarIds"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "done"
            ]
          },
          "estimateMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "order": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "dueDate",
          "priority",
          "status",
          "estimateMinutes",
          "order",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateTaskRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ],
            "default": "none"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "done"
            ],
            "default": "todo"
          },
          "estimateMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1440,
            "default": 30
          }
        },
        "required": [
          "title"
        ]
      },
      "PatchTaskRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ],
            "default": "none"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "done"
            ],
            "default": "todo"
          },
          "estimateMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1440,
            "default": 30
          }
        }
      },
      "MoveTaskRequest": {
        "type": "object",
        "properties": {
          "beforeId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{24}$/i"
          },
          "afterId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{24}$/i"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Liveness probe",
        "description": "Answers as soon as the process is running and never touches the database. Used by the hosting health check and by the web app to wake the service after it has been idle. Not rate limited.",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "The process is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Readiness probe",
        "description": "Checks that the database answers within two seconds. Not rate limited.",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Ready to serve requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Register a user",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedSession"
                }
              }
            }
          },
          "409": {
            "description": "Email is already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request did not pass validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Log in",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedSession"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request did not pass validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Log out",
        "tags": [
          "Auth"
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "403": {
            "description": "CSRF token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "Get the current auth session",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Current auth session, or anonymous state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get the current user",
        "tags": [
          "Me"
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMe",
        "summary": "Delete the current account",
        "tags": [
          "Me"
        ],
        "responses": {
          "204": {
            "description": "Account deleted"
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/settings": {
      "patch": {
        "operationId": "updateMySettings",
        "summary": "Update current user settings",
        "tags": [
          "Me"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchSettingsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request did not pass validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calendars": {
      "get": {
        "operationId": "listCalendars",
        "summary": "List calendars",
        "tags": [
          "Calendars"
        ],
        "responses": {
          "200": {
            "description": "Calendars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCalendar",
        "summary": "Create a calendar",
        "tags": [
          "Calendars"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCalendarRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created calendar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Calendar"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
