# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=agenda

# Comma-separated origins allowed to call the API directly.
# In production the frontend proxies /api/* through its own origin, so this
# only matters for direct calls (local tools, Swagger UI from another origin).
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the app (Render adds one).
TRUST_PROXY_HOPS=1

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# The demo creates an account and seeds a day on every call, so it has its own,
# stricter limit per IP and a cap on how many demo accounts exist at once.
DEMO_RATE_LIMIT_MAX=20
DEMO_MAX_ACTIVE_USERS=200

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
